# Virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Output and state
out/
.state/

# Configuration (user-specific)
configs/config.yaml

# IDE
.vscode/
.idea/

# Corp-data artifacts (real mail / LLM content) — never commit
.fixtures/
.session-reports/
*.snapshot.json
*-recording.json
# …but the synthetic eval corpus (PR7) IS committed on purpose:
!src/digest_core/eval/corpus/*.snapshot.json

# Build artifacts (uv build, make bundle)
dist/
build/
